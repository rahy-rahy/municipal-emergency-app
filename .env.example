# Copy this file to .env and adjust for your setup.
# Never commit a real .env. Keep secrets out of version control.

NODE_ENV=development
PORT=3000

# ---- Database ----
# Option A: use the bundled Docker Postgres (default values below match
# docker-compose.yml). The launcher starts it for you.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=mera_app
PGPASSWORD=localdevpass
PGDATABASE=mera
PGSSL=false

# Option B: point at your own Postgres with one line instead of the parts
# above. If set, this wins. Example for a hosted database:
# DATABASE_URL=postgres://user:password@host:5432/dbname
# PGSSL=true

# ---- Security ----
# Generate a long random value for real use, for example run:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=dev-only-insecure-secret-change-me
# Set true only when served over HTTPS.
COOKIE_SECURE=false
SESSION_MAX_AGE_HOURS=12

# Demo mode shows the quick login buttons and the reset button.
# Set false for a real deployment.
DEMO_MODE=true

# ---- Town settings ----
TOWN_NAME=Sakiet El Misk and Bhersaf
TOWN_LAT=33.9086
TOWN_LNG=35.6531
NUM_CIVIL_DEFENSE=125
NUM_RED_CROSS=140
NUM_POLICE=112

# ---- Email (optional) ----
# Leave disabled to run in console mode, where the verification link is
# printed to the server log instead of emailed.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com
# Used to build links in emails. Set to your public URL in production.
# BASE_URL=https://emergency.yourtown.gov.lb

# ---- Emergency contact ----
# The number the call button dials from the person's own phone.
EMERGENCY_CONTACT_NAME=Town emergency line
EMERGENCY_CONTACT_NUMBER=03804326
